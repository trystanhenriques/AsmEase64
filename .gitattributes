* text=auto

# Explicit endings
*.asm  text eol=crlf
*.inc  text eol=crlf
*.bat  text eol=crlf
*.sln  text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props text eol=crlf

*.sh   text eol=lf

# Binary
*.lib binary
*.obj binary
